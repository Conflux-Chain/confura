# Copy this file outside the repository or to a git-ignored path, then edit it.
# Do not put database passwords or API tokens in this file.

# Keep one Run ID across all phases of one acceptance run.
# SCANLOGS_RUN_ID=20260902T010000Z

# Locally running Confura RPC proxies.
SCANLOGS_CFX_RPC=http://127.0.0.1:22537
SCANLOGS_ETH_RPC=http://127.0.0.1:28545

# Full nodes used by both Confura's logs group and the getLogs oracle.
SCANLOGS_CFX_FN_RPC=http://127.0.0.1:12537
SCANLOGS_ETH_FN_RPC=http://127.0.0.1:18545

# Disposable local MySQL databases.
SCANLOGS_CFX_DATABASE=confura_cfx_scanlogs_test
SCANLOGS_ETH_DATABASE=confura_eth_scanlogs_test

# Direct local MySQL credentials.
SCANLOGS_MYSQL_HOST=127.0.0.1
SCANLOGS_MYSQL_PORT=3306
SCANLOGS_MYSQL_USER=root
SCANLOGS_MYSQL_PASSWORD=root

# Optional alternatives. If either is set, it takes precedence over the direct
# credentials above. Do not configure both at the same time.
# SCANLOGS_MYSQL_LOGIN_PATH=scanlogs-test
# SCANLOGS_MYSQL_DEFAULTS_FILE=/secure/scanlogs-test-mysql.cnf

SCANLOGS_CFX_ADDRESS_PARTITIONS=100
SCANLOGS_CFX_TOPIC_PARTITIONS=10
SCANLOGS_ETH_ADDRESS_PARTITIONS=100
SCANLOGS_ETH_TOPIC_PARTITIONS=10

# Copy scanlogs-local-cases.example.json and enable/fill all required cases.
SCANLOGS_CASE_MANIFEST=/absolute/path/to/scanlogs-local-cases.json

SCANLOGS_PAGE_LIMIT=7
SCANLOGS_MAX_LIMIT=1000
SCANLOGS_MAX_PAGES=10000
# Full Node getLogs oracle is automatically split into inclusive windows of
# this many epochs/blocks. Use a smaller value if the node has a tighter limit.
SCANLOGS_ORACLE_WINDOW=1000
SCANLOGS_ORACLE_TIMEOUT_SECONDS=60
SCANLOGS_E2E_DIRECTIONS=forward,reverse
SCANLOGS_E2E_VARIANTS=plain,pivot
SCANLOGS_VALIDATE_SOURCE=1
SCANLOGS_RPC_TIMEOUT_SECONDS=15

SCANLOGS_RUN_RACE=1
SCANLOGS_RUN_ALL_TESTS=1
SCANLOGS_RUN_LEGACY_GETLOGS=0

# Mutation guards. Leave disabled for normal/read-only runs.
SCANLOGS_ALLOW_DDL=${SCANLOGS_ALLOW_DDL:-no}
SCANLOGS_ALLOW_DROP=${SCANLOGS_ALLOW_DROP:-no}
